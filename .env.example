# Firebase console → Project settings → Your apps → Web app → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (required): a reCAPTCHA v3 site key (free) or a reCAPTCHA Enterprise key
VITE_RECAPTCHA_V3_KEY=
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Local development / judges: an App Check debug token registered in the console (App Check → Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=
# Optional: the cloud model (defaults to the SDK's hybrid default)
VITE_CLOUD_MODEL=
